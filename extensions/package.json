{
  "name": "regexper-ng",
  "displayName": "regexper-ng",
  "description": "Regular Expression Visualization",
  "publisher": "akatquas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AkatQuas/regexper-ng.git"
  },
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.96.0"
  },
  "icon": "media/icon.ico",
  "keywords": [
    "regexp",
    "regular expression",
    "visualization"
  ],
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "regexper-ng.visualize",
        "title": "Visualize Regexp",
        "category": "RegexperNG"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == javascript && editorHasSelection || editorLangId == typescript && editorHasSelection ",
          "command": "regexper-ng.visualize",
          "group": "z_commands"
        }
      ]
    }
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --no-devtool",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.57.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^6.0.1"
  }
}

  <body>
    <header>
      <div class="logo">
        <h1><a href="{{#if htmlWebpackPlugin.options.distUrl}}{{htmlWebpackPlugin.options.distUrl}}{{/if}}/">Regexper</a></h1>
        <!-- n. One who regexpes -->
        <span>You thought you only had two problems&hellip;</span>

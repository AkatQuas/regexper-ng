      <nav>
        <ul class="nav-list">
          <li>
            <a class="inline-icon"
              href="{{#if htmlWebpackPlugin.options.distUrl}}{{htmlWebpackPlugin.options.distUrl}}{{/if}}/changelog.html">{{icon
              "list"}}Changelog</a>
          </li>
          <li>
            <a class="inline-icon"
              href="{{#if htmlWebpackPlugin.options.distUrl}}{{htmlWebpackPlugin.options.distUrl}}{{/if}}/documentation.html">{{icon
              "document"}}Documentation</a>
          </li>
          <li>
            <a class="inline-icon" target="_blank" rel="noopener noreferrer" title="Remaster by AkatQuas" href="https://github.com/AkatQuas/regexper-ng">{{icon
